# Production Environment Variables
# Copy this file to .env.prod and fill in your production values

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_this_strong_password
MONGO_APP_USER=mtgapp
MONGO_APP_PASSWORD=change_this_app_password

# Google OAuth Configuration (Production)
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

# Session Secret (Generate with: openssl rand -hex 32)
SESSION_SECRET=your_production_session_secret_here

# URLs (Update with your production domain)
FRONTEND_URL=https://yourdomain.com
VITE_API_URL=https://yourdomain.com/api

# Optional: Email for SSL certificate
SSL_EMAIL=your-email@example.com
